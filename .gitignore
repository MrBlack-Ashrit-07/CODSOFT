# Ignore everything by default
*

# Allow the .gitignore file itself
!.gitignore

# Allow the genre classifier python script
!genre-classifier.py

# Allow the Genre Classification Dataset directory and all its contents
!Genre Classification Dataset/
!Genre Classification Dataset/**

# Allow the Document Classifier directory and its contents
!Document Classifier/
!Document Classifier/**

# Ignore large model files and python caches inside Document Classifier
Document Classifier/**/*.joblib
Document Classifier/**/__pycache__/
